<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="SourceGenerateHelper.Testing" Version="1.20.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BunnyTail.Resolver\BunnyTail.Resolver.csproj" />
    <ProjectReference Include="..\BunnyTail.Resolver.Extensions.DependencyInjection\BunnyTail.Resolver.Extensions.DependencyInjection.csproj" />
    <!-- ジェネレータは 2 回参照: analyzer として (生成コードの適用) + 通常参照 (harness テスト用) -->
    <ProjectReference Include="..\BunnyTail.Resolver.Generator\BunnyTail.Resolver.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\BunnyTail.Resolver.Generator\BunnyTail.Resolver.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Components\Components.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Expected\ComponentRegistration.expected.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
